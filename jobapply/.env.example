# ──────────────────────────────────────────────────────────
#  JobApplyPro — Environment Variables
#  Copy this file to .env.local for local development.
#  Set these variables in Vercel Dashboard → Settings → Environment Variables for production.
# ──────────────────────────────────────────────────────────

# ── PAYSTACK ──────────────────────────────────────────────
# Get from: https://dashboard.paystack.com/#/settings/developers
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_SECRET_KEY=sk_live_xx

# ── EMAIL (Gmail SMTP) ────────────────────────────────────
# Use an App Password if using Gmail with 2FA: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# ── ADMIN ─────────────────────────────────────────────────
# Email address to receive new application notifications
ADMIN_EMAIL=admin@yourdomain.com

# ── SITE URL ──────────────────────────────────────────────
# Your production Vercel URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://jobapplypro.vercel.app
